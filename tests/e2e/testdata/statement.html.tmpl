<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Monthly bank statement</title>
<style>
  @page { size: A4; margin: 14mm 12mm 18mm 12mm; }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    line-height: 1.45;
    color: #1c2733;
  }
  .masthead {
    display: table;
    width: 100%;
    border-bottom: 3px solid #1b3a5c;
    padding-bottom: 12px;
    margin-bottom: 16px;
  }
  .masthead__brand { display: table-cell; vertical-align: middle; width: 64px; }
  .masthead__logo { width: 48px; height: 48px; }
  .masthead__identity { display: table-cell; vertical-align: middle; }
  .masthead__bank { margin: 0; font-size: 20px; color: #1b3a5c; }
  .masthead__tagline { margin: 0; font-size: 11px; color: #5b6b7a; }
  .masthead__meta { display: table-cell; vertical-align: middle; text-align: right; font-size: 11px; }
  .masthead__meta-label { color: #5b6b7a; }
  .masthead__meta-value { font-weight: bold; }
  .masthead__ref { margin: 4px 0 0; font-size: 10px; color: #5b6b7a; }
  .summary { margin-bottom: 18px; }
  .summary__title { margin: 0 0 8px; font-size: 14px; color: #1b3a5c; }
  .summary__grid { display: table; width: 100%; table-layout: fixed; }
  .summary__card {
    display: table-cell;
    color: #ffffff;
    padding: 12px 14px;
    border-right: 8px solid #ffffff;
  }
  .summary__card:last-child { border-right: 0; }
  .summary__card--opening { background: #1b3a5c; }
  .summary__card--in { background: #1e7e46; }
  .summary__card--out { background: #b23b3b; }
  .summary__card--closing { background: #2f2f38; }
  .summary__card-label { margin: 0; font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; }
  .summary__card-value { margin: 2px 0 0; font-size: 18px; font-weight: bold; }
  .summary__ref { margin: 6px 0 0; font-size: 10px; color: #5b6b7a; }
  .chart { margin-bottom: 18px; }
  .chart__title { margin: 0 0 8px; font-size: 14px; color: #1b3a5c; }
  .chart__bars { display: table; width: 100%; table-layout: fixed; height: 150px; }
  .chart__column { display: table-cell; vertical-align: bottom; text-align: center; }
  .chart__bar {
    width: 60%;
    margin: 0 auto;
    background: #2f7fc4;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
  }
  .chart__bar--peak { background: #1b3a5c; }
  .chart__month { display: block; margin-top: 4px; font-size: 9px; color: #5b6b7a; }
  .chart__ref { margin: 6px 0 0; font-size: 10px; color: #5b6b7a; }
  .movements { margin-bottom: 18px; }
  .movements__title { margin: 0 0 8px; font-size: 14px; color: #1b3a5c; }
  .movements__table { width: 100%; border-collapse: collapse; font-size: 11px; }
  .movements__table thead { display: table-header-group; }
  .movements__head-cell {
    background: #1b3a5c;
    color: #ffffff;
    text-align: left;
    padding: 7px 8px;
  }
  .movements__head-cell--amount { text-align: right; }
  .movements__row { page-break-inside: avoid; }
  .movements__row:nth-child(even) { background: #eef2f6; }
  .movements__cell { padding: 5px 8px; border-bottom: 1px solid #d7dee5; }
  .movements__cell--date { white-space: nowrap; color: #5b6b7a; }
  .movements__cell--amount { text-align: right; font-weight: bold; white-space: nowrap; }
  .movements__ref { margin: 6px 0 0; font-size: 10px; color: #5b6b7a; }
  .notes { page-break-before: always; }
  .notes__title { margin: 0 0 8px; font-size: 14px; color: #1b3a5c; }
  .notes__list { margin: 0 0 16px 18px; padding: 0; }
  .notes__item { margin-bottom: 6px; }
  .notes__signature { margin-top: 24px; }
  .notes__signature-line { width: 240px; border-top: 1px solid #1c2733; padding-top: 4px; }
  .notes__ref { margin: 12px 0 0; font-size: 10px; color: #5b6b7a; }
</style>
</head>
